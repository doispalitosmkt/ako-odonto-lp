{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ako-odonto-lp",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "lp.akoodonto.com",
      "custom_domain": true
    }
